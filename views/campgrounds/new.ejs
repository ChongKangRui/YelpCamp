<% layout('layouts/boiletplate') %>

    <h1 class="text-center">New Campground</h1>

    <div class="row">
        <div class="col-6 offset-3">
            <form action="/campgrounds" method="POST" novalidate class="validated-form" enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label" for="title">Title</label>
                    <input class="form-control" type="text" placeholder="title" name="campground[title]" required>
                    <div class="invalid-feedback">
                        Please enter valid title
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="location">Location</label>
                    <input class="form-control" type="text" placeholder="location" name="campground[location]" required>
                    <div class="invalid-feedback">
                        Please enter valid location
                    </div>
                </div>
                <div class="input-group mb-3">
                    <label class="input-group-text" for="inputGroupFile01">Upload Image</label>
                    <input type="file" class="form-control" id="inputGroupFile01" name="image" multiple>
                </div>
                <!-- <div class="mb-3">
                    <label class="form-label" for="img">Image URL</label>
                    <input class="form-control" type="text" placeholder="Image URL" name="campground[image]" required>
                    <div class="invalid-feedback">
                        Please enter valid image url
                    </div>
                </div> -->


                <div class="mb-3">
                    <label class="form-label" for="price">Campground Price</label>
                    <div class="input-group">
                        <span class="input-group-text" id="price-label">$</span>
                        <input class="form-control" type="number" placeholder="0.00" name="campground[price]" required
                            aria-describedby="price-label">
                        <div class="invalid-feedback">
                            Please enter campground price
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea class="form-control" type="text" placeholder="" name="campground[description]" required
                        required></textarea>
                    <div class="invalid-feedback">
                        Please enter description
                    </div>
                </div>

                <button class="btn btn-primary col-4 float-md-start">Add Campground</button>

            </form>

            <a href="/campgrounds" class="btn btn-secondary col-4 float-md-end">Back To Campground</a>
        </div>

    </div>